(ns app.persistence)

;; PHP interop is walled off in this namespace.
;; Returns result-tagged maps so handlers can branch on data, not exceptions.

(defn find-user [conn id]
  (if-let [row (.fetchAssociative conn
                                  "SELECT id, email, name FROM users WHERE id = ?"
                                  (php/array id))]
    {:tag :ok :user row}
    {:tag :not-found}))

(defn all-users [conn]
  (.fetchAllAssociative conn "SELECT id, email, name FROM users ORDER BY id"))

(defn insert-user! [conn email user-name]
  (.insert conn "users" (php-associative-array "email" email "name" user-name))
  (php/intval (.lastInsertId conn)))
